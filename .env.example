DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# DB_ENGINE=sqlite switches to a local db.sqlite3 file and ignores DB_NAME/USER/
# PASSWORD/HOST/PORT below -- only for hosts with no free managed PostgreSQL (e.g. a
# temporary PythonAnywhere demo). Leave unset/"postgresql" for a real deployment.
DB_ENGINE=postgresql

DB_NAME=itikcare
DB_USER=itikcare_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Optional: farm's fixed GPS coordinates. Used only to prefill temperature_c/humidity_pct
# on the daily log form from a live weather API (Open-Meteo, no API key needed). Leave
# blank to disable the prefill -- the farmer can still type these fields in by hand.
FARM_LATITUDE=
FARM_LONGITUDE=

# Optional: "Sign in with Google". Create an OAuth 2.0 Client ID (type "Web
# application") in the Google Cloud Console and add your callback URL to its
# authorized redirect URIs. Leave both blank to hide the button entirely -- local
# username/password signup and login keep working either way.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Production deployment only (see the sample configs in deploy/) ---
# Leave all of the below unset for local dev; they default to safe/off values.

# Once served from a real domain, list it here (with scheme) so Django accepts POSTs
# from it, e.g. https://itikcare.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Flip these on in this order, one at a time, only after confirming HTTPS actually
# works through your reverse proxy: DJANGO_BEHIND_PROXY first, then
# DJANGO_SECURE_SSL_REDIRECT, then raise DJANGO_SECURE_HSTS_SECONDS last.
DJANGO_BEHIND_PROXY=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0

# Optional: real SMTP for password-reset emails. Leave DJANGO_EMAIL_HOST blank to print
# emails to the console instead (fine for local dev and for a first deployment).
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=webmaster@localhost

# Optional: send email through Brevo's HTTPS API instead of SMTP (for hosts that block
# SMTP, e.g. Railway's non-Pro plans). Takes precedence over DJANGO_EMAIL_HOST above.
# DJANGO_DEFAULT_FROM_EMAIL must then be a sender verified in your Brevo account.
BREVO_API_KEY=

# Optional: who gets emailed on an unhandled 500 once DJANGO_DEBUG=False. Format:
# "Name One:one@example.com,Name Two:two@example.com"
DJANGO_ADMINS=
DJANGO_SERVER_EMAIL=webmaster@localhost

# --- Railway / hosts with an ephemeral filesystem (see deploy/RAILWAY.md) ---
# Directory for uploaded media and trained model files. Unset = the project folder
# (local dev, VM). On Railway, set to the mounted volume path (e.g. /data).
DJANGO_DATA_DIR=

# True = keep rate-limit counters in a database table shared by all gunicorn workers
# (run `manage.py createcachetable` once; Railway's start command does this).
DJANGO_SHARED_CACHE=False

# Only for an external managed Postgres reached over the internet (e.g. "require").
DB_SSLMODE=

# gunicorn worker count (deploy/gunicorn_conf.py); PORT is set by Railway itself.
# WEB_CONCURRENCY=2
