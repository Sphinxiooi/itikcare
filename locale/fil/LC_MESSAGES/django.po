# Filipino translation of the ItikCare interface.
#
# Source of truth for every Filipino string in the app. After editing, rebuild the
# compiled catalog with:  python manage.py compile_translations
#
# The "Rules table" section translates the adviser's rules-table texts
# (recommendations/rules.py). Recommendation rows store the English exactly as worded
# there, and the UI looks that English up here at display time -- so any change to a
# rule's English wording in rules.py must be mirrored in its msgid below, or that
# card silently falls back to English.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: fil\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"


